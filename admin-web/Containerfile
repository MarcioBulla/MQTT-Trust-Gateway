FROM docker.io/oven/bun:1.4.4 AS build
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY frontend ./frontend
COPY shared ./shared
COPY vite.config.js ./
RUN bun run build

FROM docker.io/oven/bun:1.4.4 AS dependencies
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --production --frozen-lockfile

FROM docker.io/node:24-alpine
RUN apk add --no-cache openssl
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json LICENSE NOTICE ./
COPY src ./src
COPY shared ./shared
COPY --from=build /app/dist ./dist
ARG GATEWAY_VERSION=1.2.1
LABEL org.opencontainers.image.version=$GATEWAY_VERSION
LABEL org.opencontainers.image.source="https://github.com/MarcioBulla/MQTT-Trust-Gateway"
ARG GATEWAY_COMMIT=unknown
ARG GATEWAY_CHANNEL=stable
ARG GATEWAY_UPDATE_PUBLIC_KEY_B64=
ARG GATEWAY_SCHEMA_VERSION=1
ENV NODE_ENV=production ADMIN_APP_HOST=0.0.0.0 ADMIN_DATA_DIR=/data GATEWAY_COMMIT=$GATEWAY_COMMIT GATEWAY_CHANNEL=$GATEWAY_CHANNEL GATEWAY_UPDATE_PUBLIC_KEY_B64=$GATEWAY_UPDATE_PUBLIC_KEY_B64 GATEWAY_SCHEMA_VERSION=$GATEWAY_SCHEMA_VERSION
USER node
CMD ["node", "src/server.js"]
