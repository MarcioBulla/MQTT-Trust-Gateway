# Domain
MQTT_DOMAIN=mqtt.example.com
MQTT_USE_PUBLIC_IP=no

# Certbot
CERTBOT_EMAIL=admin@example.com
CERTBOT_ARGS=

# Container
CONTAINER_NAME=mqtt-trust-gateway
IMAGE_NAME=mqtt-trust-gateway

# Ports
ACME_HTTP_PORT=80
MQTT_TLS_PORT=8883
MQTT_WS_TLS_PORT=8443
ADMIN_HTTPS_PORT=443
ADMIN_APP_PORT=8080

# Paths on host
BASE_DIR=./runtime

# Client certificate authentication (step-ca)
MQTT_TOPIC_PREFIX=devices

# step-ca
STEP_CA_DOMAIN=ca.example.com
STEP_CA_PORT=9000
STEP_CA_URL=https://ca.example.com:9000
STEP_CA_PROVISIONER=mqtt-devices
STEP_CA_FINGERPRINT=
STEP_CA_DEVICE_CERT_TTL=17520h

# Admin Web
ADMIN_RP_NAME=MQTT-Trust-Gateway
ADMIN_RP_ID=mqtt.example.com
ADMIN_ORIGIN=https://mqtt.example.com
ADMIN_SETUP_TOKEN=
ADMIN_SESSION_SECRET=
