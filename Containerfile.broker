FROM docker.io/eclipse-mosquitto:2.1.2-alpine
ARG GATEWAY_VERSION=1.2.2
LABEL org.opencontainers.image.version=$GATEWAY_VERSION
LABEL org.opencontainers.image.source="https://github.com/MarcioBulla/MQTT-Trust-Gateway"
LABEL io.mqtt-gateway.update-gate="1"
COPY scripts/broker-entrypoint.sh /gateway-entrypoint.sh
ENTRYPOINT ["/bin/sh", "/gateway-entrypoint.sh"]
