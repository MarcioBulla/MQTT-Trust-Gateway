# Server: no domain or proxy is required for local administration.
GATEWAY_HOSTNAME=localhost
GATEWAY_DOMAIN=
LOCAL_ADDRESS=localhost
# Optional public IP shown on the dashboard; no external IP discovery service.
PUBLIC_IP=
PUBLIC_URL=http://localhost:8080
ADMIN_APP_PORT=8080
# Default loopback publishing prevents insecure remote HTTP access.
ADMIN_BIND=127.0.0.1
# Absolute host path, no spaces; leave empty to use <repository>/runtime.
DATA_DIR=
# Optional HTTPS files inside /data (copy files to runtime/admin/tls/).
ADMIN_TLS_CERT=
ADMIN_TLS_KEY=

# MQTT: container ports are fixed; these are host ports, all unprivileged.
MQTT_TLS_PORT=8883
MQTT_WS_PORT=8443
MQTT_BIND=0.0.0.0
MQTT_HOST=mqtt-broker
MQTT_TOPIC_PREFIX=devices
MQTT_RETAIN_ENABLED=true
MQTT_HISTORY_LIMIT=200

# Certificates: paths are inside the admin container.
CA_DIR=/data/ca
BROKER_CONFIG_DIR=/broker
CA_COMMON_NAME=MQTT Trust Gateway CA
CA_VALIDITY_DAYS=3650
CERT_DEFAULT_DAYS=90
CERT_MAX_DAYS=365
# Optional extra DNS SANs for BOTH MQTT TLS and WSS (comma-separated, no URLs/ports).
# MQTT_BROKER_EXTRA_SANS=example.invalid,mqtt.example.com
# Existing certificates: run ./gateway broker-certificate to apply explicitly.
MQTT_BROKER_EXTRA_SANS=
# Broker TLS certificate/key are maintained at /broker/server.crt and server.key.
# Device keys are never generated or stored by the gateway.

# Administration: comma-separated exact origins and trusted proxy IPs/CIDRs.
SESSION_HOURS=12
ALLOWED_ORIGINS=
TRUSTED_PROXIES=
# Audit events stay in SQLite for this many days; logs contain no payloads/keys.
AUDIT_RETENTION_DAYS=90
